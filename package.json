{
  "name": "private-invite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "node --env-file=.env.local scripts/db-push.mjs",
    "seed:admin": "tsx --env-file=.env.local scripts/seed-admin.ts",
    "check:rls": "tsx --env-file=.env.local scripts/check-rls.ts",
    "check:phase1": "tsx --env-file=.env.local scripts/check-phase1.ts",
    "noise": "node scripts/make-noise.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "libphonenumber-js": "1.13.15",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postgres": "3.4.9",
    "supabase": "2.121.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
