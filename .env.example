# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=
# Service role key (legacy) or sb_secret_ key. Server only.
SUPABASE_SERVICE_ROLE_KEY=
# Anon key (legacy) or sb_publishable_ key. Used on the server for admin sign in.
SUPABASE_ANON_KEY=

# Used to build links, e.g. https://invite.example.com
APP_URL=http://localhost:3000
# 32+ random bytes, signs session cookies
SESSION_SECRET=
# Protects the expiry sweep route
CRON_SECRET=

# Postgres connection string (Project Settings > Database).
# Only npm run db:push and npm run check:rls read this. The app never does.
SUPABASE_DB_URL=
